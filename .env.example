# Copy to .env in the repository root; never commit real credentials.
OPENAI_API_KEY=your_openai_api_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Use your own exact Depop template location value, never a street address.
DEPOP_SHIPPING_LOCATION=California, United States
# Optional; auto preserves provider defaults. Paid faster tiers are opt-in.
RESALE_OPENAI_SERVICE_TIER=auto
